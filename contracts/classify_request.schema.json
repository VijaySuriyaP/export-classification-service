{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Export classification request",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_request_id", "product_description", "materials", "destination_country", "client_id"],
  "properties": {
    "client_request_id": {"type": "string", "format": "uuid"},
    "product_description": {"type": "string", "minLength": 10, "maxLength": 2000},
    "materials": {"type": "array", "minItems": 1, "items": {"enum": ["stainless_steel", "carbon_steel", "alloy_steel", "iron", "aluminium", "plastic", "wood", "textile", "glass", "ceramic", "paper", "other", "unknown"]}},
    "intended_use": {"type": ["string", "null"], "maxLength": 1000},
    "weight_grams": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000000000},
    "unit_value": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000000000},
    "currency": {"enum": ["INR", "USD", "EUR", null]},
    "destination_country": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "hs_hint": {"type": ["string", "null], "pattern": "^[0-9]{2,10}$"},
    "callback_url": {"type": ["string", "null], "format": "uri"},
    "client_id": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
