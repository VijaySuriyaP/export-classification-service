# Offline-first. Configure external compatible providers only when needed.
LLM_PROVIDER=stub
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_PRIMARY=
LLM_MODEL_FALLBACK=
LLM_PRICE_IN_PER_1K=
LLM_PRICE_OUT_PER_1K=
LLM_DRY_RUN=true
EMBED_MODEL=
EMBED_MODEL_VERSION=lexical-v1
MAX_STEPS=8
MAX_TOOL_CALLS=16
MAX_WALL_CLOCK_S=30
LLM_TIMEOUT_S=15
TOOL_TIMEOUT_S=5
RETRY_MAX=2
BREAKER_FAIL_THRESHOLD=3
BREAKER_RESET_S=30
RATE_LIMIT_PER_MIN=60
DAILY_BUDGET_USD=0
POSTGRES_DB=exporter
POSTGRES_USER=exporter
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql+psycopg://exporter:change-me-local@postgres:5432/exporter
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true
VERIFIER_URL=http://verifier:8002
STUB_DELAY_MS=0
CALLBACK_ALLOWLIST=
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMPT_VERSION=v1
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=8080
CHAOS_PROVIDER_DOWN=false
